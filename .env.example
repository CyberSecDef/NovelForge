# NovelForge environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# LLM API endpoint (default: OpenAI)
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Your LLM API key (required)
LLM_API_KEY=sk-your-api-key-here

# LLM model name
LLM_MODEL=gpt-4o

# Image generation API endpoint (default: OpenAI)
IMAGE_API_URL=https://api.openai.com/v1/images/generations

# Image generation API key (required for illustrations)
IMAGE_API_KEY=sk-your-api-key-here

# Image generation model name
IMAGE_MODEL=gpt-image-1-mini

# Image generation size
IMAGE_SIZE=1024x1024

# Flask secret key - use a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Optional: override session and export directories
# SESSION_FILE_DIR=./flask_session
# EXPORT_DIR=./exports
