# NovelForge environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -------------------------------------------------------------------------
# LLM API (required — primary provider)
# -------------------------------------------------------------------------

# LLM API endpoint (must be OpenAI-compatible chat completions format)
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Your LLM API key (required)
LLM_API_KEY=sk-your-api-key-here

# LLM model name
LLM_MODEL=gpt-4o

# -------------------------------------------------------------------------
# LLM fallback providers (optional — tried in order if primary fails)
# -------------------------------------------------------------------------
# Add numbered suffixes (_2, _3, …) for fallback providers.
# Each fallback needs at least a URL; KEY and MODEL default to the primary
# if not set. If the primary exhausts all retries, the next provider is
# tried automatically.
#
# LLM_API_URL_2=https://api.backup-provider.com/v1/chat/completions
# LLM_API_KEY_2=sk-backup-key-here
# LLM_MODEL_2=gpt-4o
#
# LLM_API_URL_3=https://api.third-provider.com/v1/chat/completions
# LLM_API_KEY_3=sk-third-key-here
# LLM_MODEL_3=gpt-4o-mini

# -------------------------------------------------------------------------
# LLM tuning (optional - defaults shown)
# -------------------------------------------------------------------------

# Max retry attempts on transient errors (429, 5xx)
# LLM_MAX_RETRIES=5

# Base delay in seconds between retries (multiplied by attempt number)
# LLM_RETRY_DELAY=5

# Per-request timeout in seconds
# LLM_TIMEOUT=240

# Consecutive failures before circuit breaker trips
# LLM_CIRCUIT_BREAKER_THRESHOLD=3

# -------------------------------------------------------------------------
# Image generation (optional - needed for illustrations)
# -------------------------------------------------------------------------

# Image generation API endpoint
IMAGE_API_URL=https://api.openai.com/v1/images/generations

# Image generation API key
IMAGE_API_KEY=sk-your-api-key-here

# Image generation model name
IMAGE_MODEL=gpt-image-1-mini

# Image generation size
IMAGE_SIZE=1024x1024

# Per-request timeout in seconds for image API
# IMAGE_TIMEOUT=120

# -------------------------------------------------------------------------
# Generation limits (optional - defaults shown)
# -------------------------------------------------------------------------

# Maximum wall-clock seconds per chapter (default: 3600 = 60 minutes)
# PER_CHAPTER_TIMEOUT=3600

# Upper bound for chapter count input validation
# MAX_CHAPTERS=100

# Upper bound for word count input validation
# MAX_WORD_COUNT=500000

# -------------------------------------------------------------------------
# Flask & storage (optional - defaults shown)
# -------------------------------------------------------------------------

# Flask secret key - MUST be changed in production
SECRET_KEY=change-me-to-a-long-random-string

# Directory for Flask-Session server-side files
# SESSION_FILE_DIR=sessions/flask

# Directory for exported manuscript files and illustrations
# EXPORT_DIR=exports

# Directory for novel session JSON files (crash recovery)
# NOVELS_DIR=sessions/novels

# Directory for log files (llm.log)
# LOGS_DIR=logs

# Host and port for development server (python app.py)
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000

# Enable Flask debug mode for local development (never use in production)
# NOVELFORGE_DEBUG=false
